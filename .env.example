# Valfri lokal konfiguration. Kopiera till .env och håll filen privat.
HOST=127.0.0.1
PORT=3001
# Utan dessa används befintlig .garon-databas eller permanent datamapp.
# GARON_DB=/absolut/sökväg/till/garon.sqlite
# GARON_DATA_DIR=/absolut/sökväg/till/GARON-data
# Nycklar kan i stället sparas krypterat i appens Inställningar.
# AI måste även aktiveras uttryckligen i appen och ha budget.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
